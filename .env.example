# Kakao Developers (https://developers.kakao.com/) 에서 발급
# 앱 생성 후 REST API 키를 복사해서 아래 줄에 입력
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# 브라우저 확장에서 이 서버를 직접 호출할 때 필요
CHROME_EXTENSION_ID=your_chrome_extension_id_here

# ── 인파레이더(/crowd) — 없으면 해당 기능만 빠지고 나머지는 동작한다
# 공공데이터포털(data.go.kr) 계정 키 하나로 아래 서비스를 전부 쓴다 — 각각 포털에서 "활용신청" 필요:
#   강릉시 스마트교통정보(강원 등급 원천, 없으면 강원 전 지점 "정보 없음") · 기상청 기상특보(15000415)
#   에어코리아 대기오염정보(15073861) · TourAPI 관광정보(15101578)
#   (재난문자는 무키 SSR이 1차라 선택 — 15134001을 신청해두면 SSR 개편 시 폴백으로 가동)
# 포털이 준 URL-인코딩된 키를 그대로 넣는다 (재인코딩 금지). 미신청 서비스는 조용히 빈 값으로 강등.
DATA_GO_KR_KEY=your_data_go_kr_key_here

# 제주(GEONET) 우회 프록시 (선택): 원천이 데이터센터 IP를 거를 때 경유할 `...?url=` 프리픽스.
# 비워두면 직결 → 맥미니 스냅샷(data-jeju 브랜치) 폴백으로 동작한다.
GEONET_PROXY=

# ── 광진 라이프(/gwangjin) — 없으면 해당 카드만 발급 안내로 강등, 나머지는 동작
# 서울 열린데이터광장 인증키 하나로 지하철 도착·따릉이·강우·하천수위·대기질·주차·문화행사·
# 생활인구·건대상권 전부 커버 (https://data.seoul.go.kr/together/mypage/actKeyMain.do 즉시 발급).
# "sample" 키도 동작하지만 회당 5행 상한이라 따릉이·행사 카드는 실키에서만 찬다.
SEOUL_OPEN_KEY=your_seoul_open_key_here
# 지하철 실시간 도착은 일반 키로 호출 시 ERROR-338 — 실시간 전용 인증키를 따로 신청해 여기에.
# (미설정 시 sample 키 임시 강등으로 동작하되 5행 상한) https://data.seoul.go.kr/dataList/OA-12764/F/1/datasetView.do
SEOUL_SUBWAY_KEY=
# 무더위쉼터도 위 서울 키로 커버(TbGtnHwcwP/OA-21065 — 행안부 data.go.kr API는 폐기됨).
# 응급실 실시간 병상·약국·EV충전은 위 DATA_GO_KR_KEY 공용 — 각각 포털에서 활용신청(자동승인):
#   전국 응급의료기관 정보(15000563) · 전국 약국 정보(15000576) · 전기차 충전소 정보(15076352)

# ── 무단투기 상황판(/dumping) — 암호 게이트 내부용 대시보드
# 페이지·질의응답 API 접근 비밀번호 (미설정 시 라우트 잠김)
DUMPING_PASSWORD=
# 질의응답 LLM — Google AI Studio(https://aistudio.google.com/apikey)에서 발급
GEMINI_API_KEY=
# 기본 gemini-3.6-flash, 바꾸려면 지정
GEMINI_MODEL=
