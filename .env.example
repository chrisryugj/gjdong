# Kakao Developers (https://developers.kakao.com/) 에서 발급
# 앱 생성 후 REST API 키를 복사해서 아래 줄에 입력
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# 브라우저 확장에서 이 서버를 직접 호출할 때 필요
CHROME_EXTENSION_ID=your_chrome_extension_id_here

# ── 인파레이더(/crowd) — 없으면 해당 도시만 빠지고 나머지는 동작한다
# 강원(강릉 ITS): 공공데이터포털(data.go.kr) "강릉시 스마트교통정보" 활용신청 키.
# 포털이 준 URL-인코딩된 키를 그대로 넣는다 (재인코딩 금지). 없으면 강원 전 지점 "정보 없음".
DATA_GO_KR_KEY=your_data_go_kr_key_here

# 제주(GEONET) 우회 프록시 (선택): 원천이 데이터센터 IP를 거를 때 경유할 `...?url=` 프리픽스.
# 비워두면 직결 → 맥미니 스냅샷(data-jeju 브랜치) 폴백으로 동작한다.
GEONET_PROXY=
