{
  "name": "gjdong-extension",
  "displayName": "표준주소실록",
  "version": "3.1.0",
  "description": "한국 주소를 표준 형식으로 즉시 변환하는 브라우저 익스텐션",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.13.0",
    "plasmo": "^0.90.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "manifest": {
    "permissions": [
      "contextMenus",
      "storage",
      "clipboardRead",
      "clipboardWrite",
      "notifications",
      "activeTab",
      "scripting"
    ],
    "host_permissions": [
      "https://gjdong.vercel.app/*",
      "http://localhost:3000/*"
    ],
    "commands": {
      "convert-clipboard": {
        "suggested_key": {
          "default": "Ctrl+Shift+C",
          "mac": "Command+Shift+C"
        },
        "description": "클립보드 주소를 즉시 변환"
      }
    },
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://www.openstreetmap.org"
    }
  },
  "pnpm": {
    "comment": "보안 패치 강제. 전부 plasmo 0.90(parcel 2.9 고정)이 끌어오는 전이 의존이라 취약 범위만 overrides 로 올린다. image-size 는 패치판이 없어(2.0.2 까지 취약) .less 를 안 쓰는 이 확장에서 less→image-size 엣지를 제거. 새 항목은 plasmo build 실측 후.",
    "overrides": {
      "@parcel/reporter-dev-server@<2.16.4": "^2.16.4",
      "browserslist@<4.28.7": "^4.28.7",
      "baseline-browser-mapping@<2.11.0": "^2.11.0",
      "@babel/core@<7.29.6": "^7.29.6",
      "content-security-policy-parser@<0.6.0": "^0.6.0",
      "fflate@>=0.8.0 <0.8.3": "^0.8.3",
      "immutable@>=5.0.0 <5.1.8": "^5.1.8",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "msgpackr@<1.10.1": "^1.10.1",
      "nanoid@>=3.0.0 <3.3.18": "^3.3.18",
      "picomatch@>=2.0.0 <2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "postcss@<8.5.23": "^8.5.23",
      "postcss-selector-parser@>=6.0.0 <6.1.3": "^6.1.3",
      "sharp@<0.35.4": "^0.35.4",
      "svgo@>=2.0.0 <2.8.4": "^2.8.4",
      "tsup@<8.5.0": "^8.5.0",
      "yaml@>=1.0.0 <1.10.3": "^1.10.3",
      "yaml@>=2.0.0 <2.8.3": "^2.8.3",
      "esbuild@<0.28.1": "^0.28.1",
      "svelte@<5.55.7": "^5.55.7",
      "less>image-size": "-"
    }
  }
}
